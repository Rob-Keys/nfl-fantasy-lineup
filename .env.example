# Lambda environment variable. Use the same random value as the Cloudflare
# Pages secret named BACKEND_SHARED_SECRET.
BACKEND_SHARED_SECRET=replace-with-a-long-random-value

# Pages Function variable. Use the production site origin without a trailing slash.
ALLOWED_SITE_ORIGIN=https://nfl-fantasy-lineup.pages.dev

# Optional public sportsbook feed overrides. These are not account secrets;
# use them only when a book changes its public routing or rotates a feed key.
# FANDUEL_PUBLIC_API_KEY=FhMFpcPWXMeyZxOx
# BETMGM_PUBLIC_ACCESS_ID=replace-if-rotated
# DRAFTKINGS_NFL_EVENT_GROUP=88808
# DRAFTKINGS_SITE_CODE=dkusnj
